local M={List=table.freeze(Phrases)}
function M.pick(random,last,other)
 local start=random:NextInteger(1,#Phrases)
 for offset=0,#Phrases-1 do local i=(start+offset-1)%#Phrases+1;if i~=last and i~=other then return Phrases[i],i end end
 return Phrases[1],1
end
return table.freeze(M)
