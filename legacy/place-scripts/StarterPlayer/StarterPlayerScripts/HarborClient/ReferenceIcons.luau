local function color(value)
    return Color3.fromRGB(math.floor(value/65536),math.floor(value/256)%256,value%256)
end
function Icons.draw(parent,name)
    local data=assert(definitions[name],"Unknown reference icon")
    for index,run in data.Runs do
        local part=Instance.new("Frame")
        part.Name="Contour"..index
        part.BorderSizePixel=0
        part.BackgroundColor3=Color3.new(1,1,1)
