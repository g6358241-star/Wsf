        part.ZIndex=9
        local fill=Instance.new("UIGradient")
        fill.Name="ReferenceTone"
        fill.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,color(run[5])),
            ColorSequenceKeypoint.new(.5,color(run[6])),ColorSequenceKeypoint.new(1,color(run[7]))})
        if run[8]<255 or run[9]<255 or run[10]<255 then
            if run[3]>=5 then
                local t=math.min(.4,1.2/run[3])
                fill.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1-run[8]/255),
                    NumberSequenceKeypoint.new(t,1-run[9]/255),NumberSequenceKeypoint.new(1-t,1-run[9]/255),
                    NumberSequenceKeypoint.new(1,1-run[10]/255)})
            else
                fill.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1-run[8]/255),
                    NumberSequenceKeypoint.new(.5,1-run[9]/255),NumberSequenceKeypoint.new(1,1-run[10]/255)})
            end
        end
        fill.Parent=part
        part.Parent=parent
    end
end
